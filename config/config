# ==================== 自定义提交配置 ====================
# 本文件用于配置 SUSFS 和 SukiSU 仓库的自定义提交
#
# 使用说明:
#   1. 将 custom 设为 true 启用自定义提交功能
#   2. 在对应配置项后填入想要使用的 commit hash
#   3. 留空表示使用该分支的最新提交
#
# 示例:
#   gki-android14-6.1=abc123def456
#   sukisu=def789abc123
#
# ================================================================

# 是否启用自定义提交 (true/false)
# 2026-09-30: KSU Stable/Dev 已钉到上游最新 commit (见 .github/scripts/resolve-ksu-ref.sh)，
# SUSFS 需与之同代才能干净应用 10_enable_susfs_for_ksu.patch，故改用各分支最新 SUSFS
# (custom=false)。下方 6-22 提交保留为可快速回退的 6 月绿色基线：回退时把 custom 改回 true。
custom=false

# ==================== SUSFS 各分支的 commit hash ====================
# 仅当 custom=true 时生效
# 下列提交为 2026-06-22 (最后一次全矩阵成功编译 2026-06-29 所用) 的 SUSFS 基线，
# 用于把 SUSFS 钉回可编译版本，规避其后上游 KernelSU/SUSFS API 漂移导致的补丁 reject。
gki-android12-5.10=4003ecf2d01c
gki-android13-5.15=65ea8683c794
gki-android14-6.1=52eaf3b8fa50
gki-android15-6.6=a8c720c42ca4
gki-android16-6.12=72bdce7ce2de

# ==================== 官方版 KernelSU 的版本 ====================
# 官方版 KernelSU 的钉版不在这里，而在 .github/scripts/resolve-ksu-ref.sh 里按
# 发布层 (Stable/Dev/Latest) 解析，避免与其 tier 机制产生第二套冲突的 pin。

# ==================== SukiSU 的 commit hash ====================
# 仅当 custom=true 且使用 SukiSU 变体时生效
sukisu=

# ==================== 虚拟化补丁 (Droidspaces) 的 tag/commit ====================
# 与 custom 开关无关，虚拟化支持始终按此 ref 克隆 ravindu644/Droidspaces-OSS。
# 上游 2026-10-27 发布 v7.1.0：GKI kABI 补丁自 2026-04-22 起内容未变
# (below-kernel-6.12 与 kernel-6.12 目录树 sha 在 v6.6.0/v7.0.0/v7.1.0 完全一致)，
# 变化在 Documentation/Kernel-Configuration.md 的 GKI 配置清单：
#   新增 CONFIG_USER_NS、CONFIG_IP6_NF_NAT、CONFIG_IP6_NF_TARGET_MASQUERADE、CONFIG_MACVLAN；
#   明确 CONFIG_CFS_BANDWIDTH / CONFIG_CGROUP_PIDS 在 GKI 上必须保持关闭 (无补丁可覆盖，
#   会改动约四千个导出符号的 CRC 导致厂商模块拒绝加载)。
# 钉 tag 而非跟随 HEAD，避免上游文档/补丁漂移在同一天改变构建产物。
# 留空表示回退到 v7.1.0。
droidspaces=v7.1.0
