{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "orcarouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OrcaRouter",
      "options": {
        "baseURL": "https://api.orcarouter.ai/v1",
        "apiKey": "{env:ORCAROUTER_API_KEY}"
      },
      "models": {
        "orcarouter/auto": {
          "id": "orcarouter/auto",
          "name": "OrcaRouter Auto (adaptive routing)"
        },
        "orcarouter/free": {
          "id": "orcarouter/free",
          "name": "OrcaRouter Free"
        }
      }
    }
  }
}
